{
  "$id": "https://lowcountrydigitalworks.com/schemas/agent-trading-lab/candidate-envelope.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {"minLength": 1, "type": "string"},
    "context_refs": {"items": {"additionalProperties": true, "properties": {"available_at_utc": {"format": "date-time", "type": "string"}, "ref_id": {"minLength": 1, "type": "string"}}, "required": ["ref_id", "available_at_utc"], "type": "object"}, "type": "array"},
    "decision_time_utc": {"format": "date-time", "type": "string"},
    "event_time_utc": {"format": "date-time", "type": "string"},
    "experiment_id": {"minLength": 1, "type": "string"},
    "features": {"items": {"additionalProperties": true, "properties": {"available_at_utc": {"format": "date-time", "type": "string"}, "name": {"minLength": 1, "type": "string"}, "value": {}}, "required": ["name", "value", "available_at_utc"], "type": "object"}, "type": "array"},
    "instrument_id": {"minLength": 1, "type": "string"},
    "instrument_type": {"minLength": 1, "type": "string"},
    "market_state": {"type": "object"},
    "observation_cutoff_utc": {"format": "date-time", "type": "string"},
    "schema_version": {"const": "candidate-envelope.v1"},
    "source_id": {"minLength": 1, "type": "string"},
    "source_version": {"minLength": 1, "type": "string"},
    "state_hash": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "track": {"enum": ["0A", "0B"]},
    "venue": {"minLength": 1, "type": "string"}
  },
  "required": ["schema_version","experiment_id","track","candidate_id","event_time_utc","decision_time_utc","observation_cutoff_utc","source_id","source_version","venue","instrument_id","instrument_type","state_hash","features","market_state","context_refs"],
  "title": "CandidateEnvelope v1",
  "type": "object"
}
