{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowcountrydigitalworks.com/schemas/cryptostruct-private-evidence.v1.schema.json",
  "title": "CryptoStruct private cutoff evidence payload v1",
  "description": "Private payload carried inside the existing EvidenceEvent v1 hash-chain envelope. The EvidenceEvent envelope supplies sequence, prev_record_hash and record_hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "independent_event_id",
    "independent_event_spec_hash",
    "cryptostruct_instrument_id",
    "underlying_venue",
    "orientation",
    "category",
    "source_tool",
    "source_version",
    "scheduled_cutoff_utc",
    "request_start_utc",
    "request_complete_utc",
    "capture_timestamp_utc",
    "p_control",
    "trades_60m",
    "turnover_usd_60m",
    "spread_bps",
    "top1_depth_usd",
    "eligibility",
    "rejection_reason",
    "response_content_hash",
    "frozen_deadline_utc",
    "official_outcome",
    "resolution_evidence_hash",
    "treatment_context_hash",
    "future_model_config_hash",
    "future_p_yes",
    "future_treatment_status",
    "future_latency_ms",
    "future_input_tokens",
    "future_output_tokens",
    "future_cost_usd"
  ],
  "properties": {
    "schema_version": { "const": "cryptostruct-private-evidence.v1" },
    "independent_event_id": { "type": "string", "minLength": 1 },
    "independent_event_spec_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cryptostruct_instrument_id": { "type": "string", "minLength": 1 },
    "underlying_venue": { "const": "polymarket" },
    "orientation": { "enum": ["YES", "UP"] },
    "category": { "enum": ["WEATHER_CLIMATE", "MACROECONOMICS", "SCIENCE_TECHNOLOGY", "ENTERTAINMENT_CULTURE"] },
    "source_tool": { "enum": ["search_instruments", "get_instrument", "get_market_snapshot"] },
    "source_version": { "type": "string", "minLength": 1 },
    "scheduled_cutoff_utc": { "type": "string", "format": "date-time" },
    "request_start_utc": { "type": "string", "format": "date-time" },
    "request_complete_utc": { "type": "string", "format": "date-time" },
    "capture_timestamp_utc": { "type": "string", "format": "date-time" },
    "p_control": { "type": "number", "minimum": 0, "maximum": 1 },
    "trades_60m": { "type": "integer", "minimum": 0 },
    "turnover_usd_60m": { "type": "number", "minimum": 0 },
    "spread_bps": { "type": "number", "minimum": 0 },
    "top1_depth_usd": { "type": "number", "minimum": 0 },
    "eligibility": { "type": "boolean" },
    "rejection_reason": { "type": ["string", "null"] },
    "response_content_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "frozen_deadline_utc": { "type": "string", "format": "date-time" },
    "official_outcome": { "enum": ["YES", "NO", null] },
    "resolution_evidence_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "treatment_context_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "future_model_config_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "future_p_yes": { "type": ["number", "null"], "minimum": 0.01, "maximum": 0.99 },
    "future_treatment_status": { "type": ["string", "null"] },
    "future_latency_ms": { "type": ["integer", "null"], "minimum": 0 },
    "future_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "future_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "future_cost_usd": { "type": ["number", "null"], "minimum": 0 }
  }
}