{
  "$id": "https://lowcountrydigitalworks.com/schemas/agent-trading-lab/fill-record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {"minLength": 1, "type": "string"},
    "candidate_id": {"minLength": 1, "type": "string"},
    "effective_price": {"minimum": 0, "type": "number"},
    "execution_mode": {"minLength": 1, "type": "string"},
    "execution_time_utc": {"format": "date-time", "type": "string"},
    "fee": {"minimum": 0, "type": "number"},
    "fill_status": {"minLength": 1, "type": "string"},
    "filled_qty": {"minimum": 0, "type": "number"},
    "reference_price": {"minimum": 0, "type": "number"},
    "requested_qty": {"minimum": 0, "type": "number"},
    "schema_version": {"const": "fill-record.v1"},
    "side": {"minLength": 1, "type": "string"},
    "slippage_cost": {"minimum": 0, "type": "number"},
    "source_hash": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "spread_cost": {"minimum": 0, "type": "number"}
  },
  "required": ["schema_version","candidate_id","action_id","execution_time_utc","side","requested_qty","filled_qty","reference_price","effective_price","fee","spread_cost","slippage_cost","fill_status","execution_mode","source_hash"],
  "title": "FillRecord v1",
  "type": "object"
}
