{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowcountrydigitalworks.com/schemas/release053-final-proof-summary.v1.schema.json",
  "title": "Release 0.5.3 final source proof summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_run_id",
    "runner_commit",
    "source_contract_hash",
    "event_universe_hash",
    "query_plan_hash",
    "semantic_bundle_hash",
    "quality_screen_config_hash",
    "diagnostic_contract_hash",
    "call_budget",
    "discovery",
    "semantic",
    "snapshot",
    "quality",
    "category",
    "failures",
    "terminal_status_counts",
    "classification"
  ],
  "properties": {
    "schema_version": {
      "const": "release053-final-proof-summary.v1"
    },
    "proof_run_id": {
      "type": "string",
      "minLength": 1
    },
    "runner_commit": {
      "type": "string",
      "minLength": 1
    },
    "source_contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_universe_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "query_plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semantic_bundle_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quality_screen_config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "diagnostic_contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "call_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_attempts",
        "get_instrument_attempts",
        "snapshot_attempts",
        "total_attempts",
        "retries"
      ],
      "properties": {
        "search_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "get_instrument_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "snapshot_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "total_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 78
        },
        "retries": {
          "const": 0
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successes",
        "unique_discovered_candidates",
        "selected_candidates"
      ],
      "properties": {
        "successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "unique_discovered_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "selected_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_unique_events",
        "zero_match_unproven",
        "ambiguous_match_unproven",
        "other_unproven"
      ],
      "properties": {
        "verified_unique_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "zero_match_unproven": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_match_unproven": {
          "type": "integer",
          "minimum": 0
        },
        "other_unproven": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successes",
        "evaluable_snapshots"
      ],
      "properties": {
        "successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "evaluable_snapshots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passes",
        "rejects",
        "rejection_reason_counts"
      ],
      "properties": {
        "passes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "rejects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "rejection_reason_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low_trades_60m",
            "low_turnover_60m",
            "low_top1_depth",
            "invalid_or_wide_spread"
          ],
          "properties": {
            "low_trades_60m": {
              "type": "integer",
              "minimum": 0
            },
            "low_turnover_60m": {
              "type": "integer",
              "minimum": 0
            },
            "low_top1_depth": {
              "type": "integer",
              "minimum": 0
            },
            "invalid_or_wide_spread": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_event_counts",
        "quality_pass_counts"
      ],
      "properties": {
        "verified_event_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "WEATHER_CLIMATE",
            "MACROECONOMICS",
            "SCIENCE_TECHNOLOGY",
            "ENTERTAINMENT_CULTURE"
          ],
          "properties": {
            "WEATHER_CLIMATE": {
              "type": "integer",
              "minimum": 0
            },
            "MACROECONOMICS": {
              "type": "integer",
              "minimum": 0
            },
            "SCIENCE_TECHNOLOGY": {
              "type": "integer",
              "minimum": 0
            },
            "ENTERTAINMENT_CULTURE": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "quality_pass_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "WEATHER_CLIMATE",
            "MACROECONOMICS",
            "SCIENCE_TECHNOLOGY",
            "ENTERTAINMENT_CULTURE"
          ],
          "properties": {
            "WEATHER_CLIMATE": {
              "type": "integer",
              "minimum": 0
            },
            "MACROECONOMICS": {
              "type": "integer",
              "minimum": 0
            },
            "SCIENCE_TECHNOLOGY": {
              "type": "integer",
              "minimum": 0
            },
            "ENTERTAINMENT_CULTURE": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "failures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "parser",
        "accounting",
        "evidence_integrity"
      ],
      "properties": {
        "source": {
          "type": "integer",
          "minimum": 0
        },
        "parser": {
          "type": "integer",
          "minimum": 0
        },
        "accounting": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_integrity": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "terminal_status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SUCCESS",
        "HTTP_ERROR",
        "MCP_ERROR",
        "TIMEOUT",
        "PARSE_ERROR",
        "RUNNER_ABORTED_AFTER_RESERVATION"
      ],
      "properties": {
        "SUCCESS": {
          "type": "integer",
          "minimum": 0
        },
        "HTTP_ERROR": {
          "type": "integer",
          "minimum": 0
        },
        "MCP_ERROR": {
          "type": "integer",
          "minimum": 0
        },
        "TIMEOUT": {
          "type": "integer",
          "minimum": 0
        },
        "PARSE_ERROR": {
          "type": "integer",
          "minimum": 0
        },
        "RUNNER_ABORTED_AFTER_RESERVATION": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "classification": {
      "enum": [
        "BLOCKED",
        "INSUFFICIENT",
        "TECHNICALLY_VIABLE"
      ]
    }
  }
}
