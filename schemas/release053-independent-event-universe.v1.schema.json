{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowcountrydigitalworks.com/schemas/release053-independent-event-universe.v1.schema.json",
  "title": "Release 0.5.3 independent event universe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "derivation_contract",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "release053-independent-event-universe.v1"
    },
    "derivation_contract": {
      "const": "independent-noaa-ncei-daily-tmax-before-provider-access"
    },
    "events": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "$ref": "./independent-event-spec.v1.schema.json"
      }
    }
  }
}
